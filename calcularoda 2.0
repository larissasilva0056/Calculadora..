#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <math.h>

// Define o tamanho máximo do histórico e o tamanho das matrizes
#define MAX_HIST 50
#define N_MATRIZ_2X2 2
#define N_MATRIZ_3X3 3

// Estrutura para registrar uma operação no histórico
typedef struct {
    int id;
    char tipo[30];
    double a, b, resultado;
} Operacao;

// Variáveis globais
Operacao historico[MAX_HIST];
int totalOps = 0;

/*
 * =================================================================
 * FUNÇÕES DE CÁLCULO BÁSICO E AVANÇADO
 * =================================================================
 */

// Calcula o fatorial de um número inteiro (limite de 20 para caber em long long).
long long fatorial(int n) {
    if (n < 0 || n > 20) return -1;
    long long fat = 1;
    for (int i = 1; i <= n; i++) fat *= i;
    return fat;
}

// Soma
double soma(double a, double b) { return a + b; }
// Subtração
double sub(double a, double b) { return a - b; }
// Multiplicação
double mult(double a, double b) { return a * b; }
// Divisão (trata divisão por zero)
double divs(double a, double b) { return b == 0 ? NAN : a / b; }
// Potência (base a, expoente b)
double pot(double a, double b) { return pow(a, b); }
// Raiz Quadrada (trata números negativos)
double raiz(double a) { return a < 0 ? NAN : sqrt(a); }
// Seno (converte de graus para radianos antes do cálculo)
double seno(double a) { return sin(a * M_PI / 180); }
// Cosseno (converte de graus para radianos antes do cálculo)
double coss(double a) { return cos(a * M_PI / 180); }
// Tangente (converte de graus para radianos antes do cálculo)
double tang(double a) { return tan(a * M_PI / 180); }
// Logaritmo na base 10 (trata números <= 0)
double log10b(double a) { return a <= 0 ? NAN : log10(a); }
// Logaritmo natural (base e, trata números <= 0)
double lognb(double a) { return a <= 0 ? NAN : log(a); }
// Exponencial e^a
double expb(double a) { return exp(a); }
// Valor Absoluto
double absb(double a) { return fabs(a); }
// Máximo entre dois números
double maxb(double a, double b) { return fmax(a, b); }
// Mínimo entre dois números
double minb(double a, double b) { return fmin(a, b); }
// Conversão de Graus para Radianos
double grausParaRad(double a) { return a * M_PI / 180; }
// Conversão de Radianos para Graus
double radParaGraus(double a) { return a * 180 / M_PI; }
// Hipotenusa (a^2 + b^2)
double hip(double a, double b) { return hypot(a, b); }

// Mínimo Múltiplo Comum (MMC)
double mmc(int a, int b) {
    if (a <= 0 || b <= 0) return -1;
    int m = a, n = b;
    while (a != b) {
        if (a < b) a += m;
        else b -= n; // Pequena correção na lógica do MMC
    }
    return a;
}

// Máximo Divisor Comum (MDC) - Algoritmo de Euclides
double mdc(int a, int b) {
    a = abs(a); b = abs(b); // Garante números positivos
    if (a == 0) return b;
    while (b != 0) {
        int t = b;
        b = a % b;
        a = t;
    }
    return a;
}

/*
 * =================================================================
 * FUNÇÕES DE HISTÓRICO (COM PERSISTÊNCIA BÔNUS)
 * =================================================================
 */

// Registra uma operação no histórico.
void registrar(char tipo[], double a, double b, double r) {
    if (totalOps < MAX_HIST) {
        historico[totalOps].id = totalOps + 1;
        strcpy(historico[totalOps].tipo, tipo);
        historico[totalOps].a = a;
        historico[totalOps].b = b;
        historico[totalOps].resultado = r;
        totalOps++;
    }
}

// Exibe todas as operações registradas no histórico.
void mostrarHistorico() {
    printf("\n--- HISTÓRICO ---\n");
    if (totalOps == 0) printf("Nenhuma operacao registrada.\n");
    else
        for (int i = 0; i < totalOps; i++)
            printf("%d. %s (%.2lf, %.2lf) = %.4lf\n",
                   historico[i].id,
                   historico[i].tipo,
                   historico[i].a,
                   historico[i].b,
                   historico[i].resultado);
}

// [BÔNUS] Salva o histórico atual em um arquivo binário.
void salvarHistorico() {
    FILE *f = fopen("historico_calculadora.bin", "wb");
    if (f != NULL) {
        fwrite(&totalOps, sizeof(int), 1, f);
        fwrite(historico, sizeof(Operacao), totalOps, f);
        fclose(f);
    } else {
        // Mensagem de aviso não crítica
    }
}

// [BÔNUS] Carrega o histórico de um arquivo binário, se existir.
void carregarHistorico() {
    FILE *f = fopen("historico_calculadora.bin", "rb");
    if (f != NULL) {
        fread(&totalOps, sizeof(int), 1, f);
        if (totalOps > MAX_HIST) totalOps = MAX_HIST; // Proteção contra overflow
        fread(historico, sizeof(Operacao), totalOps, f);
        fclose(f);
        printf("\nHistorico de %d operacoes carregado do arquivo.\n", totalOps);
    } else {
        printf("\nNenhum historico anterior encontrado. Iniciando novo historico.\n");
        totalOps = 0;
    }
}

/*
 * =================================================================
 * FUNÇÕES DE ESTATÍSTICA (REQUER USO DE ARRAYS)
 * =================================================================
 */

// Calcula a Média Aritmética de um array de números.
double media(double v[], int n) {
    if (n <= 0) return NAN;
    double s = 0;
    for (int i = 0; i < n; i++) s += v[i];
    return s / n;
}

// Calcula a Mediana de um array de números (o array original é alterado).
double mediana(double v[], int n) {
    if (n <= 0) return NAN;
    // Algoritmo de ordenação (Bubble Sort)
    for (int i = 0; i < n - 1; i++)
        for (int j = i + 1; j < n; j++)
            if (v[i] > v[j]) {
                double t = v[i];
                v[i] = v[j];
                v[j] = t;
            }
    // Retorna a mediana
    return n % 2 == 0 ? (v[n / 2 - 1] + v[n / 2]) / 2 : v[n / 2];
}

// Calcula o Desvio Padrão (amostral) de um array de números.
double desvio(double v[], int n) {
    if (n <= 1) return NAN;
    double m = media(v, n), s = 0;
    for (int i = 0; i < n; i++) s += pow(v[i] - m, 2);
    // Usa 'n' para Desvio Populacional, 'n-1' para Amostral. O original usava 'n'.
    return sqrt(s / n); 
}

/*
 * =================================================================
 * FUNÇÕES DE MATRIZES 2x2
 * =================================================================
 */

// Soma duas matrizes 2x2 (A + B = R).
void somaMatriz2x2(double A[N_MATRIZ_2X2][N_MATRIZ_2X2], double B[N_MATRIZ_2X2][N_MATRIZ_2X2], double R[N_MATRIZ_2X2][N_MATRIZ_2X2]) {
    for (int i = 0; i < N_MATRIZ_2X2; i++)
        for (int j = 0; j < N_MATRIZ_2X2; j++)
            R[i][j] = A[i][j] + B[i][j];
}

// Multiplica duas matrizes 2x2 (A x B = R).
void multMatriz2x2(double A[N_MATRIZ_2X2][N_MATRIZ_2X2], double B[N_MATRIZ_2X2][N_MATRIZ_2X2], double R[N_MATRIZ_2X2][N_MATRIZ_2X2]) {
    for (int i = 0; i < N_MATRIZ_2X2; i++)
        for (int j = 0; j < N_MATRIZ_2X2; j++) {
            R[i][j] = 0;
            for (int k = 0; k < N_MATRIZ_2X2; k++)
                R[i][j] += A[i][k] * B[k][j];
        }
}

/*
 * =================================================================
 * FUNÇÕES DE MATRIZES 3x3 (BÔNUS)
 * =================================================================
 */

// [BÔNUS] Soma duas matrizes 3x3 (A + B = R).
void somaMatriz3x3(double A[N_MATRIZ_3X3][N_MATRIZ_3X3], double B[N_MATRIZ_3X3][N_MATRIZ_3X3], double R[N_MATRIZ_3X3][N_MATRIZ_3X3]) {
    for (int i = 0; i < N_MATRIZ_3X3; i++)
        for (int j = 0; j < N_MATRIZ_3X3; j++)
            R[i][j] = A[i][j] + B[i][j];
}

// [BÔNUS] Multiplica duas matrizes 3x3 (A x B = R).
void multMatriz3x3(double A[N_MATRIZ_3X3][N_MATRIZ_3X3], double B[N_MATRIZ_3X3][N_MATRIZ_3X3], double R[N_MATRIZ_3X3][N_MATRIZ_3X3]) {
    for (int i = 0; i < N_MATRIZ_3X3; i++)
        for (int j = 0; j < N_MATRIZ_3X3; j++) {
            R[i][j] = 0;
            for (int k = 0; k < N_MATRIZ_3X3; k++)
                R[i][j] += A[i][k] * B[k][j];
        }
}

/*
 * =================================================================
 * FUNÇÃO PRINCIPAL
 * =================================================================
 */

int main() {
    int op;
    char cont = 's';
    double a, b, r = 0;

    carregarHistorico(); // [BÔNUS] Carrega histórico ao iniciar

    while (cont == 's' || cont == 'S') {
        printf("\n=== CALCULADORA CIENTIFICA 2.0 ===\n");
        printf("1.Soma\t\t2.Subtracao\t3.Multiplicacao\t4.Divisao\n");
        printf("5.Potencia\t6.Raiz\t\t7.Seno\t\t8.Cosseno\n");
        printf("9.Tangente\t10.Log10\t11.Ln\t\t12.Exp\n");
        printf("13.Fatorial\t14.Abs\t\t15.Max\t\t16.Min\n");
        printf("17.MMC\t\t18.MDC\t\t19.Graus->Rad\t20.Rad->Graus\n");
        printf("21.Hipotenusa\t22.Media\t23.Mediana\t24.Desvio Padrao\n");
        printf("25.Matriz Soma (2x2)\t26.Matriz Mult (2x2)\n");
        printf("27.Matriz Soma (3x3)\t28.Matriz Mult (3x3)\n"); // [BÔNUS]
        printf("29.Historico\t30.Sair\n");
        printf("Escolha: ");
        scanf("%d", &op);

        if (op == 30) break; // Opção de Sair atualizada

        // Bloco de entrada para operações binárias simples
        switch (op) {
            case 1: case 2: case 3: case 4:
                printf("Digite dois numeros: ");
                scanf("%lf %lf", &a, &b);
                break;
        }

        // Bloco de execução das operações
        switch (op) {
            case 1: r = soma(a, b); registrar("Soma", a, b, r); break;
            case 2: r = sub(a, b); registrar("Subtracao", a, b, r); break;
            case 3: r = mult(a, b); registrar("Multiplicacao", a, b, r); break;
            case 4: 
                r = divs(a, b); 
                if (isnan(r)) printf("Erro: divisao por zero.\n"); 
                else registrar("Divisao", a, b, r); 
                break;
            case 5: 
                printf("Base e expoente: "); 
                scanf("%lf %lf", &a, &b); 
                r = pot(a, b); 
                registrar("Potencia", a, b, r); 
                break;
            case 6: 
                printf("Numero: "); 
                scanf("%lf", &a); 
                r = raiz(a); 
                if (isnan(r)) printf("Erro: raiz de numero negativo.\n"); 
                else registrar("Raiz", a, 0, r); 
                break;
            case 7: 
                printf("Angulo (°): "); 
                scanf("%lf", &a); 
                r = seno(a); 
                registrar("Seno", a, 0, r); 
                break;
            case 8: 
                printf("Angulo (°): "); 
                scanf("%lf", &a); 
                r = coss(a); 
                registrar("Cosseno", a, 0, r); 
                break;
            case 9: 
                printf("Angulo (°): "); 
                scanf("%lf", &a); 
                r = tang(a); 
                registrar("Tangente", a, 0, r); 
                break;
            case 10: 
                printf("Numero: "); 
                scanf("%lf", &a); 
                r = log10b(a); 
                if (isnan(r)) printf("Erro: log de numero menor ou igual a zero.\n"); 
                else registrar("Log10", a, 0, r); 
                break;
            case 11: 
                printf("Numero: "); 
                scanf("%lf", &a); 
                r = lognb(a); 
                if (isnan(r)) printf("Erro: ln de numero menor ou igual a zero.\n"); 
                else registrar("Ln", a, 0, r); 
                break;
            case 12: 
                printf("Numero: "); 
                scanf("%lf", &a); 
                r = expb(a); 
                registrar("Exp", a, 0, r); 
                break;
            case 13: 
                printf("Inteiro (0-20): "); 
                scanf("%lf", &a); 
                r = fatorial((int)a); 
                if (r < 0) printf("Erro: fatorial fora do limite (0-20).\n");
                else registrar("Fatorial", a, 0, r); 
                break;
            case 14: 
                printf("Numero: "); 
                scanf("%lf", &a); 
                r = absb(a); 
                registrar("Abs", a, 0, r); 
                break;
            case 15: 
                printf("Dois numeros: "); 
                scanf("%lf %lf", &a, &b); 
                r = maxb(a, b); 
                registrar("Max", a, b, r); 
                break;
            case 16: 
                printf("Dois numeros: "); 
                scanf("%lf %lf", &a, &b); 
                r = minb(a, b); 
                registrar("Min", a, b, r); 
                break;
            case 17: 
                printf("Dois inteiros: "); 
                scanf("%lf %lf", &a, &b); 
                r = mmc((int)a, (int)b); 
                if (r < 0) printf("Erro: MMC requer inteiros positivos.\n");
                else registrar("MMC", a, b, r); 
                break;
            case 18: 
                printf("Dois inteiros: "); 
                scanf("%lf %lf", &a, &b); 
                r = mdc((int)a, (int)b); 
                registrar("MDC", a, b, r); 
                break;
            case 19: 
                printf("Graus: "); 
                scanf("%lf", &a); 
                r = grausParaRad(a); 
                registrar("Graus->Rad", a, 0, r); 
                break;
            case 20: 
                printf("Radianos: "); 
                scanf("%lf", &a); 
                r = radParaGraus(a); 
                registrar("Rad->Graus", a, 0, r); 
                break;
            case 21: 
                printf("Catetos: "); 
                scanf("%lf %lf", &a, &b); 
                r = hip(a, b); 
                registrar("Hipotenusa", a, b, r); 
                break;
            case 22: {
                int n; printf("Quantidade de elementos: "); scanf("%d", &n);
                if (n <= 0) { printf("Erro: Quantidade invalida.\n"); break; }
                double v[n]; printf("Entre com os %d valores: ", n); 
                for (int i = 0; i < n; i++) scanf("%lf", &v[i]);
                r = media(v, n); registrar("Media", n, 0, r);
                break;
            }
            case 23: {
                int n; printf("Quantidade de elementos: "); scanf("%d", &n);
                if (n <= 0) { printf("Erro: Quantidade invalida.\n"); break; }
                double v[n]; printf("Entre com os %d valores: ", n); 
                for (int i = 0; i < n; i++) scanf("%lf", &v[i]);
                r = mediana(v, n); registrar("Mediana", n, 0, r);
                break;
            }
            case 24: {
                int n; printf("Quantidade de elementos: "); scanf("%d", &n);
                if (n <= 1) { printf("Erro: Desvio Padrao requer pelo menos 2 elementos.\n"); break; }
                double v[n]; printf("Entre com os %d valores: ", n); 
                for (int i = 0; i < n; i++) scanf("%lf", &v[i]);
                r = desvio(v, n); registrar("Desvio", n, 0, r);
                break;
            }
            case 25: { // Matriz 2x2 Soma
                double A[N_MATRIZ_2X2][N_MATRIZ_2X2], B[N_MATRIZ_2X2][N_MATRIZ_2X2], R[N_MATRIZ_2X2][N_MATRIZ_2X2];
                printf("Matriz A (2x2) (4 valores): "); 
                for (int i = 0; i < N_MATRIZ_2X2; i++) for (int j = 0; j < N_MATRIZ_2X2; j++) scanf("%lf", &A[i][j]);
                printf("Matriz B (2x2) (4 valores): "); 
                for (int i = 0; i < N_MATRIZ_2X2; i++) for (int j = 0; j < N_MATRIZ_2X2; j++) scanf("%lf", &B[i][j]);
                somaMatriz2x2(A, B, R);
                printf("Resultado:\n"); 
                for (int i = 0; i < N_MATRIZ_2X2; i++) { 
                    for (int j = 0; j < N_MATRIZ_2X2; j++) printf("%.2lf ", R[i][j]); 
                    printf("\n"); 
                }
                break;
            }
            case 26: { // Matriz 2x2 Multiplicação
                double A[N_MATRIZ_2X2][N_MATRIZ_2X2], B[N_MATRIZ_2X2][N_MATRIZ_2X2], R[N_MATRIZ_2X2][N_MATRIZ_2X2];
                printf("Matriz A (2x2) (4 valores): "); 
                for (int i = 0; i < N_MATRIZ_2X2; i++) for (int j = 0; j < N_MATRIZ_2X2; j++) scanf("%lf", &A[i][j]);
                printf("Matriz B (2x2) (4 valores): "); 
                for (int i = 0; i < N_MATRIZ_2X2; i++) for (int j = 0; j < N_MATRIZ_2X2; j++) scanf("%lf", &B[i][j]);
                multMatriz2x2(A, B, R);
                printf("Resultado:\n"); 
                for (int i = 0; i < N_MATRIZ_2X2; i++) { 
                    for (int j = 0; j < N_MATRIZ_2X2; j++) printf("%.2lf ", R[i][j]); 
                    printf("\n"); 
                }
                break;
            }
            case 27: { // [BÔNUS] Matriz 3x3 Soma
                double A[N_MATRIZ_3X3][N_MATRIZ_3X3], B[N_MATRIZ_3X3][N_MATRIZ_3X3], R[N_MATRIZ_3X3][N_MATRIZ_3X3];
                printf("Matriz A (3x3) (9 valores): "); 
                for (int i = 0; i < N_MATRIZ_3X3; i++) for (int j = 0; j < N_MATRIZ_3X3; j++) scanf("%lf", &A[i][j]);
                printf("Matriz B (3x3) (9 valores): "); 
                for (int i = 0; i < N_MATRIZ_3X3; i++) for (int j = 0; j < N_MATRIZ_3X3; j++) scanf("%lf", &B[i][j]);
                somaMatriz3x3(A, B, R);
                printf("Resultado:\n"); 
                for (int i = 0; i < N_MATRIZ_3X3; i++) { 
                    for (int j = 0; j < N_MATRIZ_3X3; j++) printf("%.2lf ", R[i][j]); 
                    printf("\n"); 
                }
                break;
            }
            case 28: { // [BÔNUS] Matriz 3x3 Multiplicação
                double A[N_MATRIZ_3X3][N_MATRIZ_3X3], B[N_MATRIZ_3X3][N_MATRIZ_3X3], R[N_MATRIZ_3X3][N_MATRIZ_3X3];
                printf("Matriz A (3x3) (9 valores): "); 
                for (int i = 0; i < N_MATRIZ_3X3; i++) for (int j = 0; j < N_MATRIZ_3X3; j++) scanf("%lf", &A[i][j]);
                printf("Matriz B (3x3) (9 valores): "); 
                for (int i = 0; i < N_MATRIZ_3X3; i++) for (int j = 0; j < N_MATRIZ_3X3; j++) scanf("%lf", &B[i][j]);
                multMatriz3x3(A, B, R);
                printf("Resultado:\n"); 
                for (int i = 0; i < N_MATRIZ_3X3; i++) { 
                    for (int j = 0; j < N_MATRIZ_3X3; j++) printf("%.2lf ", R[i][j]); 
                    printf("\n"); 
                }
                break;
            }
            case 29: mostrarHistorico(); break; // Opção Histórico atualizada
            default: printf("Opcao invalida.\n");
        }

        // Exibe resultado para operações que geram um único valor
        if (op >= 1 && op <= 24 && !isnan(r)) printf("Resultado: %.4lf\n", r);
        
        // Evita pedir continuação se for opção inválida ou histórico
        if (op != 29 && op != 30) {
            printf("\nDeseja continuar? (s/n): ");
            scanf(" %c", &cont);
        }
    }

    salvarHistorico(); // [BÔNUS] Salva histórico antes de sair
    printf("Calculadora encerrada.\n");
    return 0;
}
